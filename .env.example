# PostgreSQL: la misma base y el mismo rol de aplicación que usa control-gastos-backend
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=gastos_app
DATABASE_PASSWORD=example-only-database-password
DATABASE_NAME=gastos
DATABASE_POOL_MAX=5

# RabbitMQ: los mismos valores de control-gastos-backend
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=gastos
RABBITMQ_PASSWORD=example-only-rabbitmq-password-change-me

# Debe ser la misma llave de control-gastos-backend: con ella se cifraron las API Keys de Odoo
SECRETS_ENCRYPTION_KEY=example-only-encryption-key

# AWS S3: usuario de IAM con permiso s3:GetObject sobre el bucket de comprobantes
STORAGE_REGION=us-east-1
STORAGE_BUCKET=gastos-comprobantes-dev
STORAGE_ACCESS_KEY_ID=example-only-access-key-id
STORAGE_SECRET_ACCESS_KEY=example-only-secret-access-key

# Archivo SQLite con la auditoría de peticiones a Odoo; en producción debe vivir en un volumen propio
ODOO_AUDIT_DB_PATH=./data/odoo-audit.sqlite
